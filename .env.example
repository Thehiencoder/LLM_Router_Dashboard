# ==============================================================================
# LLM Router Dashboard — Environment Variables
# ==============================================================================

# API Keys (Provide any or all of these; missing keys fallback gracefully)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Mock Mode (Set to true to simulate LLM responses without consuming API credits)
MOCK_MODE=false

# Server Settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173

# CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
